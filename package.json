{
  "name": "tuition-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf": "node scripts/lighthouse.mjs",
    "check:constants": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-constants-age.ts",
    "check:deals": "NODE_OPTIONS=--conditions=react-server tsx scripts/check-deals.ts",
    "prepare": "husky",
    "snapshot:fx": "NODE_OPTIONS=--conditions=react-server tsx scripts/snapshot-fx.ts",
    "snapshot:scorecard": "NODE_OPTIONS=--conditions=react-server tsx scripts/snapshot-scorecard.ts",
    "snapshot:hud": "NODE_OPTIONS=--conditions=react-server tsx scripts/snapshot-hud.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.40.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "lighthouse": "^13.5.0",
    "msw": "3.0.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^7",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
