# Copy to .env.local for local development. Never commit .env.local.
# Every value is read server-side only (lib/server/env.ts). Nothing here reaches the browser
# except NEXT_PUBLIC_TURNSTILE_SITE_KEY, which is public by design.

# Fixtures only, no keys. Preview deploys and local dev run with this on.
DEMO_MODE=true

# Feature flags (lib/server/flags.ts)
AI_ENABLED=true
# Up to three schools side by side (step 8). Off until the comparison copy has been reviewed.
COMPARE_ENABLED=false
# "Ways to lower this number". Unset follows DEMO_MODE: on for previews, off in production.
SAVINGS_ENABLED=

# College Scorecard via api.data.gov (free key; school search at runtime)
DATA_GOV_API_KEY=

# HUD User API token (snapshot scripts only, not needed at runtime)
HUD_API_TOKEN=

# Anthropic (letter extraction and plain-English explanation). Model is configurable.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Upstash Redis for rate limiting in production. Local dev falls back to in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile bot check, AI routes only.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# "info" or "debug". Never logs user input at any level.
LOG_LEVEL=info
